{
  "name": "@nimbu/testing",
  "description": "A set of utilities useful for testing Nimbu Cloud Code and the Nimbu JS SDK",
  "version": "1.0.0",
  "author": "Zenjoy Engineering",
  "bugs": {
    "url": "https://github.com/nimbu/nimbu-testing/issues"
  },
  "dependencies": {
    "@fetch-mock/jest": "0.2.20",
    "debug": "^4.4.3",
    "nimbu-js-sdk": "2.0.0-beta.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.3.0",
    "@types/debug": "^4.1.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.17",
    "eslint": "^10.3.0",
    "eslint-plugin-jest": "^29.15.2",
    "globals": "^17.6.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "semver": "^7.7.3",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "peerDependencies": {
    "@jest/globals": "^30.0.0",
    "jest": "^30.0.0"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "files": [
    "lib"
  ],
  "keywords": [
    "nimbu"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "packageManager": "pnpm@10.33.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/nimbu/node-nimbu-client"
  },
  "scripts": {
    "build": "rm -rf lib && tsc -b",
    "beta-version-major": "npm version $(semver $npm_package_version -i premajor --preid beta)",
    "beta-version-minor": "npm version $(semver $npm_package_version -i preminor --preid beta)",
    "beta-version-patch": "npm version $(semver $npm_package_version -i prerelease --preid beta)",
    "check-types": "tsc --noEmit",
    "final-release": "npm version $(semver $npm_package_version -i)",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package-smoke": "node scripts/package-smoke.mjs",
    "prepack": "pnpm build",
    "publish:latest": "npm publish --access public",
    "publish:next": "npm publish --access public --tag next",
    "rc-version": "npm version $(semver $npm_package_version -i prerelease --preid rc)",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "version": "pnpm build"
  },
  "types": "./lib/index.d.ts"
}
